# API gateway
PORT=8080
# URL of the OCR service (in docker-compose it's the service name).
OCR_SERVICE_URL=http://ocr:8000

# Supabase Postgres — pooler transaction mode (porta 6543) per l'app
# Formato: postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase Postgres — session mode (porta 5432) per le migrazioni Prisma
# Formato: postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"

# Better Auth — segreto sessione (almeno 32 caratteri casuali)
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
# URL pubblico del backend (es. https://api.adempia.it). In locale http://127.0.0.1:8080
BETTER_AUTH_URL="http://127.0.0.1:8080"
# URL pubblico del frontend (trusted origin per le chiamate auth proxied)
FRONTEND_URL="http://127.0.0.1:43210"

# 32 byte in hex (64 caratteri) per cifrare le credenziali Alloggiati.
# Genera con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="replace-with-64-hex-chars"

# mock = nessuna chiamata alla Questura. live = adapter SOAP reale
ALLOGGIATI_MODE="mock"

# OCR service
# PORT=8000  # injected by Railway in production
